{
  "permissions": {
    "deny": ["Read(**/.env*)", "Bash(cat .env*)", "Bash(head .env*)", "Bash(tail .env*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edited-file.mjs",
            "timeout": 30,
            "statusMessage": "Quality check on the edited file..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-before-stop.mjs",
            "timeout": 600,
            "statusMessage": "Quality check, typecheck and tests..."
          }
        ]
      }
    ]
  }
}
