{
  "name": "mcp-server",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "bin": {
    "gleap-mcp": "./build/index.js"
  },
  "scripts": {
    "prepare": "sh .githooks/install.sh 2>/dev/null || exit 0",
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/test/run.mjs",
    "test:coverage": "node scripts/test/run.mjs --coverage",
    "test:quality": "node --test tools/quality/check.test.mjs",
    "quality": "node tools/quality/check.mjs --base origin/main"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GleapSDK/MCP-server.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GleapSDK/MCP-server/issues"
  },
  "homepage": "https://github.com/GleapSDK/MCP-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.2",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jose": "^5.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
